				<key>ActionBundlePath</key>
				<string>/System/Library/Automator/Run Shell Script.action</string>
				<key>ActionName</key>
				<string>Esegui script shell</string>
				<key>ActionParameters</key>
				<dict>
					<key>COMMAND_STRING</key>
					<string>n_ok=0
n_err=0
first_err=""
for f in "$@"; do
  case "${f:l}" in
    *.pdf)
      out=$(/usr/local/bin/pdfbookmarks "$f" 2&gt;&amp;1)
      if [ $? -eq 0 ]; then
        n_ok=$((n_ok + 1))
      else
        n_err=$((n_err + 1))
        if [ -z "$first_err" ]; then
          line=$(printf '%s\n' "$out" | /usr/bin/head -n 1 | /usr/bin/tr -d '"\\')
          first_err="${f:t}: ${line}"
        fi
      fi
      ;;
  esac
done
if [ "$n_err" -gt 0 ]; then
  msg="Errore su: $first_err"
elif [ "$n_ok" -eq 1 ]; then
  msg="1 PDF con segnalibri"
else
  msg="$n_ok PDF con segnalibri"
fi
msg=$(printf '%s' "$msg" | /usr/bin/tr -d '"\\')
/usr/bin/osascript -e "display notification \"$msg\" with title \"Segnalibri PDF\"" &gt;/dev/null 2&gt;&amp;1
if [ "$n_err" -gt 0 ] &amp;&amp; [ "$n_ok" -eq 0 ]; then
  exit 1
fi
exit 0
</string>
