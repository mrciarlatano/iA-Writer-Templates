				<key>ActionName</key>
				<string>Esegui script shell</string>
				<key>ActionParameters</key>
				<dict>
					<key>COMMAND_STRING</key>
					<string>/usr/bin/osascript &lt;&lt;'APPLESCRIPT'
on clean(t)
	set t to t as text
	set out to ""
	repeat with c in characters of t
		if (c as text) is not "\"" and (c as text) is not "\\" then set out to out &amp; (c as text)
	end repeat
	return out
end clean

on notify(msg)
	set m to my clean(msg)
	display notification m with title "Segnalibri PDF"
end notify

tell application "Preview"
	if (count of documents) is 0 then
		my notify("Nessun PDF aperto in Anteprima")
		return
	end if
	set theDoc to front document
	set filePath to path of theDoc
	set isMod to modified of theDoc
end tell

if filePath is missing value or (filePath as text) does not end with ".pdf" then
	my notify("Il documento aperto non è un PDF")
	return
end if

if isMod then
	my notify("Il documento ha modifiche non salvate: salvalo e riprova")
	return
end if

try
	do shell script "/usr/local/bin/pdfbookmarks " &amp; quoted form of filePath
on error errMsg
	set firstLine to paragraph 1 of (errMsg as text)
	my notify("Errore: " &amp; firstLine)
	return
end try

set fileName to do shell script "/usr/bin/basename " &amp; quoted form of filePath

tell application "Preview"
	close front document saving no
	open POSIX file filePath
end tell

my notify("Segnalibri aggiunti: " &amp; fileName)
APPLESCRIPT
